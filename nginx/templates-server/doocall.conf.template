# dooCall — SERVER mode: a HOST-level nginx owns 80/443 (TLS) and proxies
# every doocall host to this container on an internal port. This config
# only does host-routing over http and TRUSTS the forwarded proto header.
# dooCall reverse proxy — DOMAIN-DRIVEN via env (nginx envsubst templates).
#   ${DOMAIN_ROOT}   → public landing            (dev: localhost)
#   ${DOMAIN_APP}    → frontend cabinet          (dev: app.localhost)
#   ${DOMAIN_ADMIN}  → Django admin              (dev: app.admin.localhost)
# Set the real domains in .env for production — nothing else changes.
# *.localhost resolves to 127.0.0.1 automatically, no /etc/hosts needed.

# `resolve` + Docker DNS (127.0.0.11): service names are re-resolved at run
# time, so a recreated backend/frontend container (new IP) never leaves nginx
# pinned to a dead upstream (502 until reload). Requires a shared-memory zone.
upstream doocall_backend {
    zone doocall_backend 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server backend:8000 resolve;
}

upstream doocall_frontend {
    zone doocall_frontend 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server frontend:3000 resolve;
}

upstream doocall_ws {
    zone doocall_ws 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server ws:8001 resolve;
}

# Blue-green deploys run two containers of a service for a moment and the
# new one is in DNS before it listens. Give a silent peer 2s at most, then
# fail over to the live one (nothing was sent yet, so POSTs are retried too).
proxy_connect_timeout 2s;
proxy_next_upstream error timeout;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── Access log with secrets masked ─────────────────────────────────────────
# Some URLs carry secrets: per-company tokens in the path (Kotib analysis,
# Bitrix24 click-to-call) and signatures in the query (CRM recording links
# ?sig=…, MinIO presigned X-Amz-Signature=…). Log the first 4 token chars
# (enough to tell companies apart) and *** for signatures; everything else
# is logged as is. Every server block uses `access_log … masked` — a second
# http-level access_log would ADD a log next to the image's unmasked one.
map $request_uri $log_uri_path {
    "~^(?<lm_path>/api/public/(?:kotib/analysis|bitrix24/click-to-call)/)(?<lm_keep>[^/?]{0,4})[^/?]*(?<lm_rest>.*)$"  "${lm_path}${lm_keep}***${lm_rest}";
    default  $request_uri;
}
map $log_uri_path $log_uri {
    "~^(?<lm_head>[^?]*\?(?:[^#]*&)?(?:sig|X-Amz-Signature)=)[^&]*(?<lm_tail>.*)$"  "${lm_head}***${lm_tail}";
    default  $log_uri_path;
}
log_format masked '$remote_addr - $remote_user [$time_local] "$request_method $log_uri $server_protocol" '
                  '$status $body_bytes_sent "$http_referer" "$http_user_agent" "$http_x_forwarded_for"';

# ── Shared backend-proxy snippets (via named locations per block) ──────────

# ── 1. Landing: ${DOMAIN_ROOT} ──────────────────────────────────────────────
server {
    listen 80;
    server_name ${DOMAIN_ROOT} www.${DOMAIN_ROOT} doocall.local;
    access_log /var/log/nginx/access.log masked;

    client_max_body_size 25m;

    # Remote Dial: device WebSocket → ASGI `ws` service. Exact match, so
    # every other /api/ path below keeps going to gunicorn.
    location = /api/call/v1/ws {
        proxy_pass http://doocall_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /healthz/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://doocall_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}

# ── 2. Cabinet: ${DOMAIN_APP} — the frontend admin panel ───────────────────
server {
    listen 80;
    server_name ${DOMAIN_APP} app.doocall.local;
    access_log /var/log/nginx/access.log masked;

    client_max_body_size 25m;  # Base64 audio uploads (AUDIO_MAX_MB)

    # Root of the app host IS the cabinet.
    absolute_redirect off;

    location = / {
        return 302 /cabinet;
    }

    # Remote Dial: device WebSocket → ASGI `ws` service. Exact match, so
    # every other /api/ path below keeps going to gunicorn.
    location = /api/call/v1/ws {
        proxy_pass http://doocall_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /healthz/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://doocall_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}

# ── 3. Django admin: ${DOMAIN_ADMIN} — platform admin, ALL companies ───────
server {
    listen 80;
    server_name ${DOMAIN_ADMIN} app.admin.doocall.local;
    access_log /var/log/nginx/access.log masked;

    absolute_redirect off;

    # The whole host is the Django admin.
    location = / {
        return 302 /admin/;
    }

    location /admin/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /static/ {
        alias /var/www/static/;
        try_files $uri @static_backend;
    }

    location @static_backend {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
    }

    location /healthz/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
    }

    # Everything else on the admin host → the admin.
    location / {
        return 302 /admin/;
    }
}

# ── 4. Company subdomains: *.${DOMAIN_ROOT} (MoiZvonki-style) ──────────────
# Every company works on <slug>.${DOMAIN_ROOT} — cabinet UI + web API + the
# mobile /api/call/v1 endpoint all answer here. Exact server_names above
# (app/admin hosts) always win over this wildcard.
server {
    listen 80;
    server_name *.${DOMAIN_ROOT} *.doocall.local;
    access_log /var/log/nginx/access.log masked;

    client_max_body_size 25m;  # Base64 audio uploads (AUDIO_MAX_MB)

    # Root of a company host IS its cabinet.
    absolute_redirect off;

    location = / {
        return 302 /cabinet;
    }

    # Remote Dial: device WebSocket → ASGI `ws` service. Exact match, so
    # every other /api/ path below keeps going to gunicorn.
    location = /api/call/v1/ws {
        proxy_pass http://doocall_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /healthz/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://doocall_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}

# ── 5. MinIO public host: files.${DOMAIN_ROOT} (presigned URLs) ────────────
server {
    listen 80;
    server_name files.${DOMAIN_ROOT} files.doocall.local;
    access_log /var/log/nginx/access.log masked;

    client_max_body_size 500m;

    location / {
        proxy_pass http://minio:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}
