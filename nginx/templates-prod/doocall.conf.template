# dooCall — PRODUCTION nginx (TLS). Rendered via envsubst from env:
#   DOMAIN_ROOT=doocall.uz  DOMAIN_APP=app.doocall.uz  DOMAIN_ADMIN=admin.doocall.uz
# Cert: ONE wildcard certificate covering  doocall.uz + *.doocall.uz
#   /etc/letsencrypt/live/${DOMAIN_ROOT}/fullchain.pem|privkey.pem

upstream doocall_backend  { server backend:8000; }
upstream doocall_frontend { server frontend:3000; }

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── HTTP → HTTPS (ACME webroot left open for http-01 renewals) ─────────────
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── 1. Landing: https://${DOMAIN_ROOT} (+ www) ─────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_ROOT} www.${DOMAIN_ROOT};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_ROOT}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_ROOT}/privkey.pem;

    client_max_body_size 25m;

    location /api/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /healthz/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
    }
    location / {
        proxy_pass http://doocall_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# ── 2. Portals: https://${DOMAIN_APP} (cabinet/admin/partner, path-routed) ─
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_APP};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_ROOT}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_ROOT}/privkey.pem;

    client_max_body_size 25m;

    location = / { return 302 /cabinet; }

    location /api/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /healthz/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
    }
    location / {
        proxy_pass http://doocall_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# ── 3. Django admin: https://${DOMAIN_ADMIN} ───────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_ADMIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_ROOT}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_ROOT}/privkey.pem;

    location = / { return 302 /admin/; }

    location /admin/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /static/ {
        alias /var/www/static/;
        try_files $uri @static_backend;
    }
    location @static_backend {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
    }
    location /healthz/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
    }
    location / { return 302 /admin/; }
}

# ── 4. MinIO public host: https://files.${DOMAIN_ROOT} (presigned URLs) ────
server {
    listen 443 ssl;
    http2 on;
    server_name files.${DOMAIN_ROOT};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_ROOT}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_ROOT}/privkey.pem;

    client_max_body_size 500m;

    location / {
        proxy_pass http://minio:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# ── 5. Company subdomains: https://*.${DOMAIN_ROOT} (MoiZvonki-style) ──────
# Exact names above always win; everything else on the wildcard is a
# company cabinet + its web/mobile API.
server {
    listen 443 ssl;
    http2 on;
    server_name *.${DOMAIN_ROOT};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_ROOT}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_ROOT}/privkey.pem;

    client_max_body_size 25m;

    location = / { return 302 /cabinet; }

    location /api/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /healthz/ {
        proxy_pass http://doocall_backend;
        proxy_set_header Host $host;
    }
    location / {
        proxy_pass http://doocall_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
