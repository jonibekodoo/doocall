<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doocall_call_list" model="ir.ui.view">
        <field name="name">doocall.call.list</field>
        <field name="model">doocall.call</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-success="status == 'answered'"
                  decoration-danger="status in ('no_answer','failed')"
                  decoration-warning="status == 'busy'">
                <field name="start_time"/>
                <field name="direction"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="lead_id" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="operator" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'answered'"
                       decoration-danger="status in ('no_answer','failed')"
                       decoration-warning="status == 'busy'"/>
                <field name="duration_display"/>
                <field name="record_url" column_invisible="1"/>
                <button name="action_play_record" type="object" icon="fa-play-circle"
                        title="Yozuvni tinglash" invisible="not record_url"/>
            </list>
        </field>
    </record>

    <record id="view_doocall_call_form" model="ir.ui.view">
        <field name="name">doocall.call.form</field>
        <field name="model">doocall.call</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_label" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'answered'"
                                   decoration-danger="status in ('no_answer','failed')"
                                   decoration-warning="status == 'busy'"/>
                            <field name="phone"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="operator"/>
                        </group>
                        <group>
                            <field name="start_time"/>
                            <field name="duration_display"/>
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                        </group>
                    </group>
                    <group string="Audio yozuv" invisible="not record_url">
                        <field name="player_html" nolabel="1" colspan="2"/>
                        <field name="record_url" widget="url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_doocall_call_search" model="ir.ui.view">
        <field name="name">doocall.call.search</field>
        <field name="model">doocall.call</field>
        <field name="arch" type="xml">
            <search>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="operator"/>
                <filter string="Kiruvchi" name="inbound" domain="[('direction','=','inbound')]"/>
                <filter string="Chiquvchi" name="outbound" domain="[('direction','=','outbound')]"/>
                <separator/>
                <filter string="Javob berilgan" name="answered" domain="[('status','=','answered')]"/>
                <filter string="Javobsiz" name="no_answer" domain="[('status','=','no_answer')]"/>
                <separator/>
                <filter string="Bugun" name="today"
                        domain="[('date','=', context_today())]"/>
                <group expand="0" string="Guruhlash">
                    <filter string="Operator" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Kontakt" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Holat" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Sana" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Hisobot (dashboard) ko'rinishlari ─────────────────────────── -->
    <record id="view_doocall_call_graph" model="ir.ui.view">
        <field name="name">doocall.call.graph</field>
        <field name="model">doocall.call</field>
        <field name="arch" type="xml">
            <graph string="DooCall qo'ng'iroqlari" type="bar" stacked="1" sample="1">
                <field name="date" interval="day"/>
                <field name="status"/>
            </graph>
        </field>
    </record>

    <record id="view_doocall_call_pivot" model="ir.ui.view">
        <field name="name">doocall.call.pivot</field>
        <field name="model">doocall.call</field>
        <field name="arch" type="xml">
            <pivot string="DooCall qo'ng'iroqlari" sample="1">
                <field name="user_id" type="row"/>
                <field name="status" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_doocall_calls" model="ir.actions.act_window">
        <field name="name">DooCall qo'ng'iroqlari</field>
        <field name="res_model">doocall.call</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hozircha qo'ng'iroqlar yo'q</p>
            <p>DooCall xizmatidan qo'ng'iroqlar avtomatik shu yerga tushadi.</p>
        </field>
    </record>

    <record id="action_doocall_report" model="ir.actions.act_window">
        <field name="name">DooCall tahlili</field>
        <field name="res_model">doocall.call</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{"search_default_group_date": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hozircha ma'lumot yo'q</p>
        </field>
    </record>

    <menuitem id="menu_doocall_root" name="DooCall" sequence="65"
              web_icon="doocall,static/description/icon.png"/>
    <menuitem id="menu_doocall_calls" name="Qo'ng'iroqlar" parent="menu_doocall_root"
              action="action_doocall_calls" sequence="10"/>
    <menuitem id="menu_doocall_report" name="Hisobot" parent="menu_doocall_root"
              action="action_doocall_report" sequence="20"/>

    <!-- CRM'ning Reporting bo'limiga ham qo'shamiz -->
    <menuitem id="menu_doocall_report_crm" name="DooCall qo'ng'iroqlari"
              parent="crm.crm_menu_report" action="action_doocall_report"
              sequence="50"/>
</odoo>
