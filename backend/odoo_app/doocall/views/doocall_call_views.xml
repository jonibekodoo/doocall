<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doocall_call_list" model="ir.ui.view">
        <field name="name">doocall.call.list</field>
        <field name="model">doocall.call</field>
        <field name="arch" type="xml">
            <list>
                <field name="start_time"/>
                <field name="direction"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="lead_id" optional="hide"/>
                <field name="operator" optional="show"/>
                <field name="status"/>
                <field name="duration_display"/>
                <button name="action_play_record" type="object" icon="fa-play-circle"
                        title="Yozuvni tinglash" invisible="not record_url"/>
            </list>
        </field>
    </record>

    <record id="view_doocall_call_form" model="ir.ui.view">
        <field name="name">doocall.call.form</field>
        <field name="model">doocall.call</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_label" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="status"/>
                            <field name="phone"/>
                            <field name="operator"/>
                        </group>
                        <group>
                            <field name="start_time"/>
                            <field name="duration_display"/>
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                        </group>
                    </group>
                    <group string="Audio yozuv" invisible="not record_url">
                        <field name="player_html" nolabel="1" colspan="2"/>
                        <field name="record_url" widget="url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_doocall_call_search" model="ir.ui.view">
        <field name="name">doocall.call.search</field>
        <field name="model">doocall.call</field>
        <field name="arch" type="xml">
            <search>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="operator"/>
                <filter string="Kiruvchi" name="inbound" domain="[('direction','=','inbound')]"/>
                <filter string="Chiquvchi" name="outbound" domain="[('direction','=','outbound')]"/>
                <separator/>
                <filter string="Javob berilgan" name="answered" domain="[('status','=','answered')]"/>
                <filter string="Javobsiz" name="no_answer" domain="[('status','=','no_answer')]"/>
                <group expand="0" string="Guruhlash">
                    <filter string="Kontakt" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Operator" name="group_operator" context="{'group_by': 'operator'}"/>
                    <filter string="Sana" name="group_date" context="{'group_by': 'start_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_doocall_calls" model="ir.actions.act_window">
        <field name="name">DooCall qo'ng'iroqlari</field>
        <field name="res_model">doocall.call</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hozircha qo'ng'iroqlar yo'q</p>
            <p>DooCall xizmatidan qo'ng'iroqlar avtomatik shu yerga tushadi.</p>
        </field>
    </record>

    <menuitem id="menu_doocall_root" name="DooCall" sequence="65"
              web_icon="doocall,static/description/icon.png"/>
    <menuitem id="menu_doocall_calls" name="Qo'ng'iroqlar" parent="menu_doocall_root"
              action="action_doocall_calls" sequence="10"/>
</odoo>
