<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_doocall" model="ir.ui.view">
        <field name="name">crm.lead.form.doocall</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_doocall_calls" type="object"
                        class="oe_stat_button" icon="fa-phone"
                        invisible="doocall_call_count == 0">
                    <field name="doocall_call_count" widget="statinfo" string="Qo'ng'iroqlar"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="DooCall qo'ng'iroqlari" name="doocall_calls"
                      invisible="doocall_call_count == 0">
                    <field name="doocall_call_ids" readonly="1">
                        <list>
                            <field name="start_time"/>
                            <field name="direction"/>
                            <field name="status"/>
                            <field name="operator"/>
                            <field name="duration_display"/>
                            <button name="action_play_record" type="object"
                                    icon="fa-play-circle" title="Yozuvni tinglash"
                                    invisible="not record_url"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
