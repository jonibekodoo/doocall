# ─────────────────────────────────────────────────────────────────────────
# dooCall (CallCloud) — environment template (master spec §10).
# Copy to `.env` and adjust. Every variable the stack reads lives here.
# Values marked (PLACEHOLDER) are pinned by the master spec — confirm before prod.
# ─────────────────────────────────────────────────────────────────────────

# ── Django ─────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=doocall.settings
DJANGO_SECRET_KEY=dev-insecure-change-me
DEBUG=true
DJANGO_ALLOWED_HOSTS=.jprq.live,localhost,127.0.0.1,backend,app.localhost,app.admin.localhost,doocall.local,app.doocall.local,app.admin.doocall.local
TZ=Asia/Tashkent

# ── Postgres 16 ────────────────────────────────────────────────────────────
POSTGRES_DB=doocall
POSTGRES_USER=doocall
POSTGRES_PASSWORD=doocall
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host-side bind for the db container (5433 avoids clashing with a local Postgres)
POSTGRES_HOST_PORT=5433
# Host-side bind for the backend container (8001 avoids clashing with other stacks)
BACKEND_HOST_PORT=8001
DB_CONN_MAX_AGE=60

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Celery ─────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── MinIO / object storage ─────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=doocall-recordings
MINIO_USE_SSL=false
# Host embedded in presigned audio URLs returned to devices (dev: host-published port)
MINIO_PUBLIC_ENDPOINT=localhost:9000
# true when a TLS tunnel/CDN fronts MinIO (e.g. jprq): presigned URLs become https
MINIO_PUBLIC_USE_SSL=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── JWT (web cabinet auth — SimpleJWT) ─────────────────────────────────────
JWT_SECRET_KEY=dev-jwt-insecure-change-me-needs-32-bytes-minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30

# ── Payment gateways (PLACEHOLDER — real credentials in master spec/vault) ──
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_ENDPOINT=https://checkout.paycom.uz
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_ENDPOINT=https://api.click.uz/v2

# ── Domains ────────────────────────────────────────────────────────────────
# Dev: *.localhost resolves to 127.0.0.1 automatically (no /etc/hosts).
# Prod: set your real domains here — nginx/Django/CORS all follow.
#   DOMAIN_ROOT=doocall.uz  DOMAIN_APP=app.doocall.uz  DOMAIN_ADMIN=admin.doocall.uz
DOMAIN_ROOT=localhost
DOMAIN_APP=app.localhost
DOMAIN_ADMIN=app.admin.localhost
# Public demo tunnels (jprq.io): nginx serves these exact hosts too.
JPRQ_LANDING_HOST=doocall.jprq.live
JPRQ_APP_HOST=doocall-app.jprq.live
# Company subdomains: every company works on <slug>.DOMAIN_ROOT
# (dev: <slug>.localhost, prod: deepvision.doocall.uz). Prod needs a wildcard DNS record
# (*.doocall.uz) + wildcard TLS cert. The refresh cookie is shared across
# subdomains via COOKIE_DOMAIN (prod: .doocall.uz; dev: empty — Chromium
# won't share *.localhost cookies, the landing→subdomain hop uses a
# one-time /auth/handoff code instead).
COOKIE_DOMAIN=
# http in dev; set https in production (absolute cabinet/portal URLs).
URL_SCHEME=http

# ── Email (Mailhog in dev) ─────────────────────────────────────────────────
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@doocall.local

# ── Feature flags ──────────────────────────────────────────────────────────
EMAIL_VERIFICATION_ENABLED=false

# ── Business config (PLACEHOLDER values — confirm against master spec §10) ──
TRIAL_DAYS=14
DEFAULT_PRICE_PER_OPERATOR_UZS=50000
AUDIO_MAX_MB=20

# ── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://app.localhost/api/call/v1
NEXT_PUBLIC_APP_DOMAIN=app.localhost
